toolchain("clang") {
  toolchain_args = {
    current_cpu = target_cpu
    current_os = target_os
  }

  helper = rebase_path("//build/scripts/gn_helper.py", root_build_dir)
  cc = vela_cc
  cxx = vela_cxx
  archiver = vela_archiver
  python = vela_python
  compiler_wrapper = ""
  if (cc_wrapper != "") {
    compiler_wrapper = "\"$cc_wrapper\" "
  }

  if (target_os == "win") {
    object_extension = "obj"
    archive_extension = ".lib"
    executable_extension = ".exe"
    lib_switch = ""
    lib_dir_switch = "/LIBPATH:"
  } else {
    object_extension = "o"
    archive_extension = ".a"
    executable_extension = ""
    lib_switch = "-l"
    lib_dir_switch = "-L"
  }

  if (target_os == "win") {
    tool("cc") {
      command = "$compiler_wrapper\"$cc\" /nologo /showIncludes /c {{source}} /Fo{{output}} {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}}"
      depsformat = "msvc"
      description = "CC {{output}}"
      outputs = [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.$object_extension" ]
    }

    tool("cxx") {
      command = "$compiler_wrapper\"$cxx\" /nologo /showIncludes /c {{source}} /Fo{{output}} /TP {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}}"
      depsformat = "msvc"
      description = "CXX {{output}}"
      outputs = [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.$object_extension" ]
    }
  } else {
    tool("asm") {
      depfile = "{{output}}.d"
      depsformat = "gcc"
      command = "$compiler_wrapper\"$cc\" -MD -MF {{output}}.d -c {{source}} -o {{output}} {{defines}} {{include_dirs}} {{cflags}} {{asmflags}}"
      description = "ASM {{output}}"
      outputs = [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.$object_extension" ]
    }

    # Clang 输出 Make 格式依赖；-MD
    # 同时跟踪第三方系统头，防止依赖更新后沿用旧 ABI。
    tool("cc") {
      depfile = "{{output}}.d"
      depsformat = "gcc"
      command = "$compiler_wrapper\"$cc\" -MD -MF {{output}}.d -c {{source}} -o {{output}} {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}}"
      description = "CC {{output}}"
      outputs = [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.$object_extension" ]
    }

    tool("cxx") {
      depfile = "{{output}}.d"
      depsformat = "gcc"
      command = "$compiler_wrapper\"$cxx\" -MD -MF {{output}}.d -c {{source}} -o {{output}} {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}}"
      description = "CXX {{output}}"
      outputs = [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.$object_extension" ]
    }
  }

  tool("alink") {
    command = "\"$python\" \"$helper\" archive --tool \"$archiver\" --output {{output}} --rspfile {{output}}.rsp"
    description = "AR {{output}}"
    rspfile = "{{output}}.rsp"
    rspfile_content = "{{inputs_newline}}"
    outputs = [ "{{output_dir}}/{{target_output_name}}{{output_extension}}" ]
    default_output_dir = "{{target_out_dir}}"
    default_output_extension = archive_extension
  }

  tool("link") {
    if (target_os == "win") {
      command = "\"$cxx\" /nologo -fuse-ld=lld @{{output}}.rsp /Fe{{output}}"
    } else if (target_os == "mac") {
      # Xcode 链接器及配套 LTO 匹配当前 SDK。
      linker_directory = get_path_info(vela_linker, "dir")
      lto_library = "$linker_directory/../lib/libLTO.dylib"
      command = "\"$cxx\" -fuse-ld=\"$vela_linker\" -mlinker-version=$vela_linker_version -Wl,-lto_library,\"$lto_library\" @{{output}}.rsp -o \"{{output}}\""
    } else {
      command =
          "\"$cxx\" -fuse-ld=\"$vela_linker\" @{{output}}.rsp -o \"{{output}}\""
    }
    description = "LINK {{output}}"
    rspfile = "{{output}}.rsp"
    rspfile_content = "{{inputs}} {{solibs}} {{ldflags}} {{libs}}"
    outputs = [ "{{output_dir}}/{{target_output_name}}{{output_extension}}" ]
    default_output_dir = "{{root_out_dir}}"
    default_output_extension = executable_extension
  }

  tool("stamp") {
    command = "\"$python\" \"$helper\" touch \"{{output}}\""
    description = "STAMP {{output}}"
  }

  tool("copy") {
    command = "\"$python\" \"$helper\" copy \"{{source}}\" \"{{output}}\""
    description = "COPY {{source}}"
  }
}
