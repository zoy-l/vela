import("abseil_sources.gni")

if (target_os == "win") {
  # 官方预编译包的 rpmalloc 对象会全局覆写
  # malloc/free，不能改变嵌入宿主的分配器。 从锁定归档生成
  # CRT 链接变体；原始第三方输入保持不变。
  llvm_support_archive = "$vela_llvm_root/lib/LLVMSupport.lib"
  llvm_crt_support = "$root_gen_dir/third_party/vela_llvm_support.lib"
  action("llvm_crt_support") {
    script = "//tools/llvm_support_archive.py"
    inputs = [ llvm_support_archive ]
    outputs = [ llvm_crt_support ]
    args = [
      "--archiver",
      "$vela_llvm_root/bin/llvm-ar.exe",
      "--source",
      rebase_path(inputs[0], root_build_dir),
      "--output",
      rebase_path(outputs[0], root_build_dir),
    ]
  }
}

config("llvm_headers") {
  llvm_include = "$vela_llvm_root/include"

  # 使用 SDK 的 RTTI 契约；派生 ORC 层时不能引用无 RTTI
  # 库未提供的 typeinfo。
  if (vela_llvm_rtti == "NO") {
    if (target_os == "win") {
      cflags_cc = [ "/GR-" ]
    } else {
      cflags_cc = [ "-fno-rtti" ]
    }
  }
  if (target_os == "win") {
    cflags = [ "/external:I$llvm_include" ]
  } else {
    cflags = [
      "-isystem",
      llvm_include,
    ]
  }
}

config("clang_tooling_headers") {
  defines = [ "CLANG_BUILD_STATIC" ]
  clang_include = "$vela_clang_root/include"
  if (target_os == "win") {
    cflags = [ "/external:I$clang_include" ]
  } else {
    cflags = [
      "-isystem",
      clang_include,
    ]
  }
}

template("llvm_component") {
  tooling = defined(invoker.tooling) && invoker.tooling
  config("${target_name}_libraries") {
    libs = invoker.libraries + invoker.system_libraries
    if (target_os == "win") {
      libs -= [ llvm_support_archive ]
      libs += [ llvm_crt_support ]
      if (tooling) {
        libs += [ "version.lib" ]
      }
    }
  }
  source_set(target_name) {
    public_configs = [
      ":llvm_headers",
      ":${target_name}_libraries",
    ]
    if (tooling) {
      public_configs += [ ":clang_tooling_headers" ]
    }
    public_deps = [
      ":zlib",
      ":zstd",
    ]
    if (target_os == "win") {
      public_deps += [ ":llvm_crt_support" ]
    }
  }
}

llvm_component("llvm") {
  libraries = vela_llvm_libraries
  system_libraries = vela_llvm_system_libraries
}

llvm_component("llvm_jit") {
  libraries = vela_llvm_jit_libraries
  system_libraries = vela_llvm_jit_system_libraries
}

llvm_component("llvm_loader") {
  libraries = vela_llvm_loader_libraries
  system_libraries = vela_llvm_loader_system_libraries
}

llvm_component("clang_tooling") {
  libraries = vela_clang_libraries + vela_llvm_tooling_libraries
  system_libraries = vela_llvm_tooling_system_libraries
  tooling = true
}

