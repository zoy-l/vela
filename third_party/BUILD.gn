import("abseil_sources.gni")

copy("pcre2_config") {
  sources = [ "pcre2/src/config.h.generic" ]
  outputs = [ "$target_gen_dir/pcre2/config.h" ]
}

copy("pcre2_header") {
  sources = [ "pcre2/src/pcre2.h.generic" ]
  outputs = [ "$target_gen_dir/pcre2/pcre2.h" ]
}

copy("pcre2_chartables") {
  sources = [ "pcre2/src/pcre2_chartables.c.dist" ]
  outputs = [ "$target_gen_dir/pcre2/pcre2_chartables.c" ]
}

config("pcre2_headers") {
  defines = [
    "PCRE2_STATIC",
    "PCRE2_CODE_UNIT_WIDTH=8",
  ]
  pcre2_include = rebase_path("$target_gen_dir/pcre2", root_build_dir)
  if (target_os == "win") {
    cflags = [ "/external:I$pcre2_include" ]
  } else {
    cflags = [
      "-isystem",
      pcre2_include,
    ]
  }
}

static_library("pcre2") {
  configs -= [ "//build/config:vela_warnings" ]
  deps = [
    ":pcre2_chartables",
    ":pcre2_config",
    ":pcre2_header",
  ]
  public_configs = [ ":pcre2_headers" ]
  include_dirs = [
    "pcre2/src",
    "$target_gen_dir/pcre2",
  ]
  defines = [
    "HAVE_CONFIG_H",
    "SUPPORT_PCRE2_8",
    "SUPPORT_UNICODE",
    "MATCH_LIMIT=1000000",
    "MATCH_LIMIT_DEPTH=1000",
    "HEAP_LIMIT=8192",
    "LINK_SIZE=2",
  ]
  sources = [
    "$target_gen_dir/pcre2/pcre2_chartables.c",
    "pcre2/src/pcre2_auto_possess.c",
    "pcre2/src/pcre2_chkdint.c",
    "pcre2/src/pcre2_compile.c",
    "pcre2/src/pcre2_compile_cgroup.c",
    "pcre2/src/pcre2_compile_class.c",
    "pcre2/src/pcre2_config.c",
    "pcre2/src/pcre2_context.c",
    "pcre2/src/pcre2_error.c",
    "pcre2/src/pcre2_extuni.c",
    "pcre2/src/pcre2_find_bracket.c",
    "pcre2/src/pcre2_jit_compile.c",
    "pcre2/src/pcre2_match.c",
    "pcre2/src/pcre2_match_data.c",
    "pcre2/src/pcre2_newline.c",
    "pcre2/src/pcre2_ord2utf.c",
    "pcre2/src/pcre2_pattern_info.c",
    "pcre2/src/pcre2_script_run.c",
    "pcre2/src/pcre2_string_utils.c",
    "pcre2/src/pcre2_study.c",
    "pcre2/src/pcre2_substring.c",
    "pcre2/src/pcre2_tables.c",
    "pcre2/src/pcre2_ucd.c",
    "pcre2/src/pcre2_valid_utf.c",
    "pcre2/src/pcre2_xclass.c",
  ]
}

config("xxhash_headers") {
  xxhash_include = rebase_path("xxhash", root_build_dir)
  if (target_os == "win") {
    cflags = [ "/external:I$xxhash_include" ]
  } else {
    cflags = [
      "-isystem",
      xxhash_include,
    ]
  }
}

static_library("xxhash") {
  configs -= [ "//build/config:vela_warnings" ]
  sources = [ "xxhash/xxhash.c" ]
  public_configs = [ ":xxhash_headers" ]
}

config("yyjson_headers") {
  yyjson_include = rebase_path("yyjson/src", root_build_dir)
  if (target_os == "win") {
    cflags = [ "/external:I$yyjson_include" ]
  } else {
    cflags = [
      "-isystem",
      yyjson_include,
    ]
  }
}

static_library("yyjson") {
  configs -= [ "//build/config:vela_warnings" ]
  sources = [ "yyjson/src/yyjson.c" ]
  public_configs = [ ":yyjson_headers" ]
}

config("utf8proc_headers") {
  utf8proc_include = rebase_path("utf8proc", root_build_dir)
  defines = [ "UTF8PROC_STATIC" ]
  if (target_os == "win") {
    cflags = [ "/external:I$utf8proc_include" ]
  } else {
    cflags = [
      "-isystem",
      utf8proc_include,
    ]
  }
}

static_library("utf8proc") {
  configs -= [ "//build/config:vela_warnings" ]
  sources = [ "utf8proc/utf8proc.c" ]
  public_configs = [ ":utf8proc_headers" ]
}

config("abseil_headers") {
  abseil_include = rebase_path("abseil-cpp", root_build_dir)
  if (target_os == "win") {
    cflags = [ "/external:I$abseil_include" ]
  } else {
    cflags = [
      "-isystem",
      abseil_include,
    ]
  }
}

config("abseil_link") {
  if (target_os != "win") {
    cflags = [ "-pthread" ]
    ldflags = [ "-pthread" ]
    if (target_os == "linux") {
      libs = [
        "dl",
        "rt",
      ]
    } else if (target_os == "mac") {
      ldflags += [
        "-framework",
        "CoreFoundation",
      ]
    }
  }
}

static_library("abseil") {
  configs -= [ "//build/config:vela_warnings" ]
  sources = abseil_container_sources
  if (target_os == "win") {
    # 保持上游 absl/copts 的 Windows CRT 配置，仅作用于 Abseil
    # 源文件。
    defines = [
      "_CRT_SECURE_NO_WARNINGS",
      "_SCL_SECURE_NO_WARNINGS",
    ]
  }
  public_configs = [
    ":abseil_headers",
    ":abseil_link",
  ]
}

config("gtest_headers") {
  gtest_include = rebase_path("googletest/googletest/include", root_build_dir)
  if (target_os == "win") {
    cflags = [ "/external:I$gtest_include" ]
  } else {
    cflags = [
      "-isystem",
      gtest_include,
      "-pthread",
    ]
    ldflags = [ "-pthread" ]
  }
}

static_library("gtest") {
  testonly = true

  # 自有代码额外启用警告，第三方保留默认诊断。
  configs -= [ "//build/config:vela_warnings" ]
  sources = [ "googletest/googletest/src/gtest-all.cc" ]
  include_dirs = [ "googletest/googletest" ]
  public_configs = [ ":gtest_headers" ]
}

static_library("gtest_main") {
  testonly = true
  configs -= [ "//build/config:vela_warnings" ]
  sources = [ "googletest/googletest/src/gtest_main.cc" ]
  public_deps = [ ":gtest" ]
}

config("benchmark_headers") {
  benchmark_include = rebase_path("benchmark/include", root_build_dir)
  defines = [ "BENCHMARK_STATIC_DEFINE" ]
  if (target_os == "win") {
    cflags = [ "/external:I$benchmark_include" ]
  } else {
    cflags = [
      "-isystem",
      benchmark_include,
      "-pthread",
    ]
    ldflags = [ "-pthread" ]
  }
}

config("benchmark_link") {
  if (target_os == "win") {
    libs = [ "shlwapi.lib" ]
  }
}

static_library("benchmark") {
  testonly = true
  configs -= [ "//build/config:vela_warnings" ]
  sources = [
    "benchmark/src/benchmark.cc",
    "benchmark/src/benchmark_api_internal.cc",
    "benchmark/src/benchmark_name.cc",
    "benchmark/src/benchmark_register.cc",
    "benchmark/src/benchmark_runner.cc",
    "benchmark/src/check.cc",
    "benchmark/src/colorprint.cc",
    "benchmark/src/commandlineflags.cc",
    "benchmark/src/complexity.cc",
    "benchmark/src/console_reporter.cc",
    "benchmark/src/counter.cc",
    "benchmark/src/csv_reporter.cc",
    "benchmark/src/json_reporter.cc",
    "benchmark/src/perf_counters.cc",
    "benchmark/src/reporter.cc",
    "benchmark/src/statistics.cc",
    "benchmark/src/string_util.cc",
    "benchmark/src/sysinfo.cc",
    "benchmark/src/timers.cc",
  ]
  defines = [
    "BENCHMARK_VERSION=\"1.9.5\"",
    "HAVE_STD_REGEX",
    "HAVE_STEADY_CLOCK",
    "HAVE_THREAD_SAFETY_ATTRIBUTES",
  ]
  if (target_os == "win") {
    # 与上游 CMake 一致，使用标准 CRT 接口。
    defines += [ "_CRT_SECURE_NO_WARNINGS" ]
  }
  public_configs = [
    ":benchmark_headers",
    ":benchmark_link",
  ]
}

static_library("benchmark_main") {
  testonly = true
  configs -= [ "//build/config:vela_warnings" ]
  sources = [ "benchmark/src/benchmark_main.cc" ]
  public_deps = [ ":benchmark" ]
}
