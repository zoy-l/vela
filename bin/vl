#!/usr/bin/env python3
"""Vela developer command entry point."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
raise SystemExit(
    subprocess.run(
        [sys.executable, "-m", "tools.vl", *sys.argv[1:]], cwd=ROOT, check=False
    ).returncode
)
