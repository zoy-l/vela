Checks:
  - '-*'
  - 'bugprone-*'
  - 'cert-*'
  - 'cppcoreguidelines-*'
  - 'modernize-*'
  # Ordinary functions use leading return types; lambdas retain required C++ syntax.
  - '-modernize-use-trailing-return-type'
  - 'misc-include-cleaner'
  - 'performance-*'
  - 'portability-*'
  - 'readability-*'
  # Vela uses #pragma once as its repository-wide header guard convention.
  - '-portability-avoid-pragma-once'
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(^|[/\\])third_party[/\\]'
FormatStyle: file
CheckOptions:
  readability-trailing-comma.SingleLineCommaPolicy: Ignore
  readability-trailing-comma.MultiLineCommaPolicy: Append
