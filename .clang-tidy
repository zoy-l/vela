Checks:
  - '-*'
  - 'bugprone-*'
  - 'cert-*'
  - 'cppcoreguidelines-*'
  - 'modernize-*'
  - 'misc-include-cleaner'
  - 'performance-*'
  - 'portability-*'
  - 'readability-*'
  # Vela uses #pragma once as its repository-wide header guard convention.
  - '-portability-avoid-pragma-once'
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(^|[/\\])third_party[/\\]'
FormatStyle: file
