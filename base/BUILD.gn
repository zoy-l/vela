source_set("base") {
  sources = [
    "arity.h",
    "array_algorithm.h",
    "async_operation.h",
    "binary.cc",
    "binary.h",
    "binary_codec.h",
    "binary_fields.h",
    "builtin.h",
    "byte_access.h",
    "callable.h",
    "command_line.cc",
    "command_line.h",
    "declaration.h",
    "diagnostic.cc",
    "diagnostic.h",
    "execution_limits.h",
    "execution_status.cc",
    "execution_status.h",
    "file.cc",
    "file.h",
    "file_publication.h",
    "fingerprint.cc",
    "fingerprint.h",
    "integer_arithmetic.h",
    "integer_parse.h",
    "json_decode.h",
    "layout_description.cc",
    "layout_description.h",
    "member.h",
    "native_binding.cc",
    "native_binding.h",
    "native_program_mode.h",
    "opcode.h",
    "path.cc",
    "path.h",
    "process_exit.h",
    "reflection.h",
    "reflection_operation.h",
    "regexp.h",
    "source_lines.cc",
    "source_lines.h",
    "source_location.h",
    "streams.h",
    "utf8.cc",
    "utf8.h",
  ]
  deps = [ "//third_party:xxhash" ]
  if (target_os == "win") {
    sources += [ "file_publication_win.cc" ]
  } else {
    sources += [ "file_publication_posix.cc" ]
  }
}

source_set("directory_watcher") {
  sources = [
    "directory_watcher.cc",
    "directory_watcher.h",
  ]
  if (target_os == "win") {
    sources += [
      "directory_watcher_win.cc",
      "directory_watcher_win.h",
    ]
  } else if (target_os == "mac") {
    sources += [
      "directory_watcher_mac.cc",
      "directory_watcher_mac.h",
    ]
    frameworks = [ "CoreServices.framework" ]
  } else {
    sources += [
      "directory_watcher_linux.cc",
      "directory_watcher_linux.h",
    ]
  }
  deps = [ ":base" ]
  public_deps = [ "//third_party:abseil" ]
}

source_set("json") {
  sources = [
    "json.cc",
    "json.h",
  ]
  public_deps = [ "//third_party:yyjson" ]
}

source_set("regexp_diagnostic") {
  sources = [
    "regexp_diagnostic.cc",
    "regexp_diagnostic.h",
  ]
  deps = [ "//third_party:pcre2" ]
}

source_set("temporary_directory") {
  testonly = true
  sources = [
    "testing/temporary_directory.cc",
    "testing/temporary_directory.h",
  ]
}

source_set("test_directory") {
  testonly = true
  deps = [ ":base" ]
  sources = [
    "testing/directory.cc",
    "testing/directory.h",
  ]
  public_deps = [
    ":temporary_directory",
    "//third_party:gtest",
  ]
}

executable("base_tests") {
  testonly = true
  sources = [
    "binary_unittest.cc",
    "directory_watcher_unittest.cc",
    "file_unittest.cc",
    "fingerprint_unittest.cc",
    "integer_arithmetic_unittest.cc",
    "json_unittest.cc",
    "utf8_unittest.cc",
  ]
  deps = [
    ":base",
    ":directory_watcher",
    ":json",
    ":test_directory",
    "//third_party:gtest_main",
  ]
}
