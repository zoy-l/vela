InheritParentConfig: true
# Reference ports retain upstream coefficients and conventional algorithm symbols.
# Buffer bounds come from fixed algorithm dimensions and the prepared container sizes.
Checks:
  - '-cppcoreguidelines-avoid-magic-numbers'
  - '-readability-magic-numbers'
  - '-cppcoreguidelines-pro-bounds-avoid-unchecked-container-access'
  - '-cppcoreguidelines-pro-bounds-constant-array-index'
  - '-cppcoreguidelines-pro-bounds-pointer-arithmetic'
CheckOptions:
  readability-identifier-length.IgnoredVariableNames: '^([a-hijkmnuvxyz]|[pvdszcn][xyz]|[vst][012])$'
  readability-identifier-length.IgnoredParameterNames: '^([a-hijkmnuvxyz]|[pvdszcn][xyz]|[vst][012])$'
