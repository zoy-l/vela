import 'input' as data;

const unit = 'A中😀e\u0301Z\0';
const text = unit + unit + unit + unit;
const inputs = [text, ' \u3000${text}\u0085\t', ' \u3000\t'];

func run(): int {
  let checksum = 0;
  for (const value in data.values) {
    const result = inputs[value % inputs.length].trim();
    checksum += result.byteLength + result.length;
  }
  return checksum;
}

func main(): void {
  data.prepare(256);
  print(run());
}
