import 'input' as data;

func run(): int {
  let checksum = 0;
  const size = data.values.length;
  for (let index = 0; index < size; index ++) {
    const value = data.values[index];
    const text = 'Vela_${value}';
    const upper = text.toUpperCase();
    const lower = upper.toLowerCase();
    if (lower != 'vela_${value}') {
      return -1;
    }
    checksum += lower.byteLength;
  }
  return checksum;
}

func main(): void {
  data.prepare(64);
  print(run());
}
