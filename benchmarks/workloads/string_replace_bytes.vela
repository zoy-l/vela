import 'input' as data;

const unit = 'A中😀e\u0301Z\0';
const text = unit + unit + unit + unit;

func run(): int {
  let checksum = 0;
  for (const value in data.values) {
    const start = value % 4 * unit.byteLength + 1;
    const result = text.replaceBytes(start, start + '中'.byteLength, value % 2 == 0 ? '好' : '🙂');
    checksum += result.byteLength + result.length;
  }
  return checksum;
}

func main(): void {
  data.prepare(256);
  print(run());
}
