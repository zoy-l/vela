func main(): int {
  let total = 0;
  let key = 0;
  for (let index = 0; index < 1000; index = index + 1) {
    if (key == 0) total = total + 0;
    else if (key == 1) total = total + 1;
    else if (key == 2) total = total + 2;
    else if (key == 3) total = total + 3;
    else if (key == 4) total = total + 4;
    else if (key == 5) total = total + 5;
    else if (key == 6) total = total + 6;
    else total = total + 7;
    key = key + 1;
    if (key == 8) key = 0;
  }
  return total;
}
