func main(): int {
  const values: int[] = [999, 500, 2, 0, 1, 42];
  values.sort((left, right) => left - right);
  let total = 0;
  for (let index = 0; index < 100; index = index + 1) {
    total = total + values.reduce((sum, value) => sum + value, 0);
  }
  // Mapping produces one independent typed array.
  const mapped = values.map(value => value + 1);
  return total + mapped[0] + 345099;
}
