func main(): int {
  const values: int[] = [999, 500, 2, 0, 1, 42];
  values.sort((left: int, right: int): int => left - right);
  let total = 0;
  for (let index = 0; index < 100; index = index + 1) {
    total = total + values.reduce(0, (sum: int, value: int): int => sum + value);
  }
  // The traversal exercises captured callbacks and mutation on a typed array.
  values.transform((value: int): int => value + 1);
  return total + 345100;
}
