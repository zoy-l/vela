executable("vela_benchmarks") {
  testonly = true
  sources = [
    "async_benchmark.cc",
    "byte_data_benchmark.cc",
    "compilation_cache_benchmark.cc",
    "completion_benchmark.cc",
    "gc_strategy_benchmark.cc",
    "heap_metrics.cc",
    "heap_metrics.h",
    "json_benchmark.cc",
    "liveness_benchmark.cc",
    "mock_benchmark.cc",
    "native_call_benchmark.cc",
    "native_call_kernels.cc",
    "native_call_kernels.h",
    "native_standard_workloads.cc",
    "native_standard_workloads.h",
    "native_workloads.cc",
    "native_workloads.h",
    "process_memory.h",
    "regexp_benchmark.cc",
    "repl_benchmark.cc",
    "representative_benchmark.cc",
    "source.cc",
    "source.h",
    "specialization_benchmark.cc",
    "standard_value_benchmark.cc",
    "standard_value_benchmark.h",
    "string_index_benchmark.cc",
    "symbol_tables_benchmark.cc",
    "temporary_directory.cc",
    "temporary_directory.h",
    "testing_benchmark.cc",
    "vm_benchmark.cc",
  ]
  benchmark_source_dir = rebase_path("//benchmarks", "")
  defines = [ "VELA_BENCHMARK_SOURCE_DIR=\"$benchmark_source_dir\"" ]
  deps = [
    "//base:json",
    "//base:temporary_directory",
    "//compiler",
    "//compiler:testing",
    "//compiler:tooling",
    "//third_party:benchmark_main",
    "//third_party:luajit",
    "//third_party:pcre2",
  ]
  if (target_os == "win") {
    sources += [ "process_memory_win.cc" ]
  } else if (target_os == "mac") {
    sources += [ "process_memory_mac.cc" ]
  } else {
    sources += [ "process_memory_linux.cc" ]
  }
}

aot_native_directory = "$target_gen_dir/aot_native"
aot_object = "$aot_native_directory/workload.o"
aot_compiler = "$root_out_dir/vela"
if (target_os == "win") {
  aot_object = "$aot_native_directory/workload.obj"
  aot_compiler += ".exe"
}

action("aot_native_inputs") {
  testonly = true
  script = "//tools/aot_benchmarks.py"
  inputs = [
    "aot_workloads.vela",
    "aot_cases.json",
    "spectral_norm.vela",
  ]
  outputs = [
    aot_object,
    "$aot_object.h",
    "$aot_object.aot.json",
    "$aot_native_directory/entries.h",
    "$aot_native_directory/build_metrics.json",
  ]
  args = [
    "--suite=aot",
    "--compiler",
    rebase_path(aot_compiler, root_build_dir),
    "--source",
    rebase_path("aot_workloads.vela", root_build_dir),
    "--cases",
    rebase_path("aot_cases.json", root_build_dir),
    "--output",
    rebase_path(aot_native_directory, root_build_dir),
  ]
  deps = [ "//compiler:vela" ]
}

dasprofile_directory = "$target_gen_dir/dasprofile_native"
dasprofile_object = "$dasprofile_directory/workload.o"
map_literal_directory = "$target_gen_dir/map_literal_native"
map_literal_object = "$map_literal_directory/workload.o"
if (target_os == "win") {
  dasprofile_object = "$dasprofile_directory/workload.obj"
  map_literal_object = "$map_literal_directory/workload.obj"
}

action("map_literal_native_inputs") {
  testonly = true
  script = "//tools/map_literal_benchmarks.py"
  inputs = [ "//tools/aot_benchmarks.py" ]
  outputs = [
    map_literal_object,
    "$map_literal_object.h",
    "$map_literal_object.aot.json",
    "$map_literal_directory/workload.vela",
    "$map_literal_directory/entries.h",
    "$map_literal_directory/build_metrics.json",
  ]
  args = [
    "--compiler",
    rebase_path(aot_compiler, root_build_dir),
    "--output",
    rebase_path(map_literal_directory, root_build_dir),
  ]
  deps = [ "//compiler:vela" ]
}

executable("vela_aot_benchmarks") {
  testonly = true
  sources = [
    "aot_benchmark.cc",
    "aot_benchmark_memory.cc",
    "aot_benchmark_memory.h",
    "aot_benchmark_types.h",
    "dasprofile/dasprofile_benchmark.cc",
    "dasprofile/host_kernel.cc",
    "dasprofile/workloads.cc",
    "dasprofile/workloads.h",
    "escape_benchmark.cc",
    "generics_benchmark.cc",
    "heap_metrics.cc",
    "heap_metrics.h",
    "jit_benchmark.cc",
    "jit_benchmark.h",
    "map_literal_benchmark.cc",
    "map_literal_benchmark.h",
    "process_memory.h",
    "reload_benchmark.cc",
    aot_object,
    dasprofile_object,
    map_literal_object,
  ]
  if (target_os == "win") {
    sources += [ "process_memory_win.cc" ]
  } else if (target_os == "mac") {
    sources += [ "process_memory_mac.cc" ]
  } else {
    sources += [ "process_memory_linux.cc" ]
  }
  include_dirs = [ root_gen_dir ]
  benchmark_source = rebase_path("aot_workloads.vela", "")
  dasprofile_source = rebase_path("dasprofile/workloads.vela", "")
  defines = [
    "VELA_AOT_BENCHMARK_SOURCE=\"$benchmark_source\"",
    "VELA_DASPROFILE_BENCHMARK_SOURCE=\"$dasprofile_source\"",
  ]
  deps = [
    ":aot_native_inputs",
    ":dasprofile_native_inputs",
    ":map_literal_native_inputs",
    "//compiler",
    "//compiler:aot",
    "//compiler:checkpoint_publication",
    "//compiler:development",
    "//runtime",
    "//third_party:benchmark_main",
  ]
}

action("dasprofile_native_inputs") {
  testonly = true
  script = "//tools/aot_benchmarks.py"
  inputs = [
    "dasprofile/cases.json",
    "dasprofile/workloads.vela",
    "spectral_norm.vela",
  ]
  outputs = [
    dasprofile_object,
    "$dasprofile_object.h",
    "$dasprofile_object.aot.json",
    "$dasprofile_directory/entries.h",
    "$dasprofile_directory/build_metrics.json",
  ]
  args = [
    "--suite=dasprofile",
    "--compiler",
    rebase_path(aot_compiler, root_build_dir),
    "--source",
    rebase_path("dasprofile/workloads.vela", root_build_dir),
    "--cases",
    rebase_path("dasprofile/cases.json", root_build_dir),
    "--output",
    rebase_path(dasprofile_directory, root_build_dir),
  ]
  deps = [ "//compiler:vela" ]
}
