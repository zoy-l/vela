source_set("jit_benchmark_support") {
  testonly = true
  sources = [
    "aot_benchmark_memory.cc",
    "aot_benchmark_memory.h",
    "heap_metrics.cc",
    "heap_metrics.h",
    "jit_benchmark.cc",
    "jit_benchmark.h",
    "process_memory.h",
  ]
  if (target_os == "win") {
    sources += [ "process_memory_win.cc" ]
  } else if (target_os == "mac") {
    sources += [ "process_memory_mac.cc" ]
  } else {
    sources += [ "process_memory_linux.cc" ]
  }
  public_deps = [ "//compiler:development" ]
  deps = [ "//third_party:benchmark" ]
}

source_set("aot_benchmark_kernels") {
  testonly = true
  sources = [
    "aot_benchmark_kernels.cc",
    "aot_benchmark_kernels.h",
    "aot_benchmark_types.h",
  ]
}

executable("vela_benchmark_tests") {
  testonly = true
  sources = [
    "aot_benchmark_unittest.cc",
    "jit_benchmark_unittest.cc",
    aot_object,
  ]
  include_dirs = [ root_gen_dir ]
  test_source = rebase_path("aot_workloads.vela", "")
  defines = [ "VELA_AOT_BENCHMARK_SOURCE=\"$test_source\"" ]
  deps = [
    ":aot_benchmark_kernels",
    ":aot_native_inputs",
    ":jit_benchmark_support",
    "//base:test_directory",
    "//third_party:gtest_main",
  ]
}

