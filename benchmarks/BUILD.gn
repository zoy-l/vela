import("//build/native_bindings.gni")

generated_file("native_class_configuration") {
  testonly = true
  outputs = [ "$target_gen_dir/native_class.json" ]
  output_conversion = "json"
  contents = {
    module = "nativeclass"
    headers = [ rebase_path("native_class_host.h", target_gen_dir) ]
    translation_unit = rebase_path("native_class_host.cc", target_gen_dir)
    compilation_database =
        rebase_path("$root_build_dir/compile_commands.json", target_gen_dir)
    output = "native_class"
  }
}

vela_native_bindings("native_class_generation") {
  testonly = true
  config = "$target_gen_dir/native_class.json"
  outputs = [
    "$target_gen_dir/native_class/nativeclass.vela",
    "$target_gen_dir/native_class/nativeclass_bindings.h",
    "$target_gen_dir/native_class/nativeclass_bindings.cc",
    "$target_gen_dir/native_class/nativeclass.bindings.json",
  ]
  depfile = "$target_gen_dir/native_class/nativeclass.d"
  deps = [ ":native_class_configuration" ]
}

source_set("native_class_host") {
  testonly = true
  sources = [
    "$target_gen_dir/native_class/nativeclass_bindings.cc",
    "native_class_host.cc",
    "native_class_host.h",
  ]
  include_dirs = [ root_gen_dir ]
  public_deps = [
    ":native_class_generation",
    "//include:bindings",
    "//runtime",
  ]
  deps = [ "//third_party:benchmark" ]
}

native_class_object = "$target_gen_dir/native_class/workload.o"
native_class_compiler = "$root_out_dir/vela"
if (target_os == "win") {
  native_class_object = "$target_gen_dir/native_class/workload.obj"
  native_class_compiler += ".exe"
}

action("native_class_inputs") {
  testonly = true
  script = "//tools/native_class_benchmarks.py"
  inputs = [ "//tools/aot_benchmarks.py" ]
  outputs = [
    native_class_object,
    "$native_class_object.h",
    "$native_class_object.aot.json",
    "$target_gen_dir/native_class/entries.h",
    "$target_gen_dir/native_class/workloads.vela",
    "$target_gen_dir/native_class/build_metrics.json",
  ]
  args = [
    "--compiler",
    rebase_path(native_class_compiler, root_build_dir),
    "--output",
    rebase_path("$target_gen_dir/native_class", root_build_dir),
  ]
  deps = [
    ":native_class_generation",
    "//compiler:vela",
  ]
}

generated_file("native_class_paths") {
  testonly = true
  outputs = [ "$target_gen_dir/native_class/paths.h" ]
  workload_path = rebase_path("$target_gen_dir/native_class/workloads.vela")
  contents = [
    "#pragma once",
    "#include <string_view>",
    "namespace vela::benchmarks::native_class {",
    "inline constexpr std::string_view kWorkloadPath = R\"($workload_path)\";",
    "}",
    "",
  ]
}

executable("vela_benchmarks") {
  testonly = true
  sources = [
    "async_benchmark.cc",
    "byte_data_benchmark.cc",
    "compilation_cache_benchmark.cc",
    "completion_benchmark.cc",
    "execution_benchmark.cc",
    "file_capture_benchmark.cc",
    "gc_strategy_benchmark.cc",
    "heap_metrics.cc",
    "heap_metrics.h",
    "json_benchmark.cc",
    "liveness_benchmark.cc",
    "mock_benchmark.cc",
    "native_standard_workloads.cc",
    "native_standard_workloads.h",
    "native_workloads.cc",
    "native_workloads.h",
    "process_memory.h",
    "regexp_benchmark.cc",
    "repl_benchmark.cc",
    "representative_benchmark.cc",
    "source.cc",
    "source.h",
    "specialization_benchmark.cc",
    "standard_value_benchmark.cc",
    "standard_value_benchmark.h",
    "string_index_benchmark.cc",
    "symbol_tables_benchmark.cc",
    "temporary_directory.cc",
    "temporary_directory.h",
    "testing_benchmark.cc",
    "typed_json_benchmark.cc",
  ]
  benchmark_source_dir = rebase_path("//benchmarks", "")
  defines = [ "VELA_BENCHMARK_SOURCE_DIR=\"$benchmark_source_dir\"" ]
  deps = [
    "//base:json",
    "//base:temporary_directory",
    "//compiler:development",
    "//compiler:jit",
    "//compiler:testing",
    "//compiler:tooling",
    "//runtime",
    "//third_party:benchmark_main",
    "//third_party:luajit",
    "//third_party:pcre2",
  ]
  if (target_os == "win") {
    sources += [ "process_memory_win.cc" ]
  } else if (target_os == "mac") {
    sources += [ "process_memory_mac.cc" ]
  } else {
    sources += [ "process_memory_linux.cc" ]
  }
}

aot_native_directory = "$target_gen_dir/aot_native"
aot_object = "$aot_native_directory/workload.o"
native_call_directory = "$target_gen_dir/native_call"
native_call_object = "$native_call_directory/workload.o"
aot_compiler = "$root_out_dir/vela"
if (target_os == "win") {
  aot_object = "$aot_native_directory/workload.obj"
  native_call_object = "$native_call_directory/workload.obj"
  aot_compiler += ".exe"
}

action("aot_native_inputs") {
  testonly = true
  script = "//tools/aot_benchmarks.py"
  inputs = [
    "aot_workloads.vela",
    "aot_cases.json",
    "spectral_norm.vela",
  ]
  outputs = [
    aot_object,
    "$aot_object.h",
    "$aot_object.aot.json",
    "$aot_native_directory/entries.h",
    "$aot_native_directory/build_metrics.json",
  ]
  args = [
    "--suite=aot",
    "--compiler",
    rebase_path(aot_compiler, root_build_dir),
    "--source",
    rebase_path("aot_workloads.vela", root_build_dir),
    "--cases",
    rebase_path("aot_cases.json", root_build_dir),
    "--output",
    rebase_path(aot_native_directory, root_build_dir),
  ]
  deps = [ "//compiler:vela" ]
}

action("native_call_inputs") {
  testonly = true
  script = "//tools/native_call_benchmarks.py"
  inputs = [ "//tools/aot_benchmarks.py" ]
  outputs = [
    native_call_object,
    "$native_call_object.h",
    "$native_call_object.aot.json",
    "$native_call_directory/entries.h",
    "$native_call_directory/workloads.vela",
    "$native_call_directory/build_metrics.json",
  ]
  args = [
    "--compiler",
    rebase_path(aot_compiler, root_build_dir),
    "--output",
    rebase_path(native_call_directory, root_build_dir),
  ]
  deps = [ "//compiler:vela" ]
}

algorithms_directory = "$target_gen_dir/algorithms_native"
algorithms_object = "$algorithms_directory/workload.o"
map_literal_directory = "$target_gen_dir/map_literal_native"
map_literal_object = "$map_literal_directory/workload.o"
if (target_os == "win") {
  algorithms_object = "$algorithms_directory/workload.obj"
  map_literal_object = "$map_literal_directory/workload.obj"
}

action("map_literal_native_inputs") {
  testonly = true
  script = "//tools/map_literal_benchmarks.py"
  inputs = [ "//tools/aot_benchmarks.py" ]
  outputs = [
    map_literal_object,
    "$map_literal_object.h",
    "$map_literal_object.aot.json",
    "$map_literal_directory/workload.vela",
    "$map_literal_directory/entries.h",
