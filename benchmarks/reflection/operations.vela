const info = Reflect.typeInfo<Counter>();
const reflectedModule = info.module;
const cachedField = info.findField('value');
const cachedMethod = info.findMethod('add');
const cachedConstructor = info.getConstructor();
const argument = CallArgument(value: 0);
const arguments = CallArguments(items: [argument]);
export func reflectedField(values: int[]): int {
  const field = cachedField;
  if (field == null) { return -1; }
  let sum = 0;
  for (let i = 0; i < values.length; i++) {
    field.setValue(object, values[i]);
    const value = field.getValue(object);
    if (!(value is int)) { return -1; }
    sum += value;
  }
  return sum;
}
export func reflectedCall(values: int[]): int {
  const method = cachedMethod;
  if (method == null) { return -1; }
  let sum = 0;
  for (let i = 0; i < values.length; i++) {
    argument.value = values[i];
    const value = method.invoke(object, arguments);
    if (!(value is int)) { return -1; }
    sum += value;
  }
  return sum;
}
export func packedCall(values: int[]): int {
  const method = cachedMethod;
  if (method == null) { return -1; }
  let sum = 0;
  for (let i = 0; i < values.length; i++) {
    const value = method.invoke(object, CallArguments(items: [CallArgument(value: values[i])]));
    if (!(value is int)) { return -1; }
