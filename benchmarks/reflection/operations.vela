export func reflectedConstruct(values: int[]): int {
  const ctor = cachedConstructor;
  const field = cachedField;
  if (ctor == null || field == null) { return -1; }
  let sum = 0;
  for (let i = 0; i < values.length; i++) {
    const created = ctor.invoke(CallArguments(items: [CallArgument(value: values[i], name: 'value')]));
    if (!(created is Counter)) { return -1; }
    const value = field.getValue(created);
    if (!(value is int)) { return -1; }
    sum += value;
  }
  return sum;
}
export func typeLookup(values: int[]): int {
  const module = reflectedModule;
  if (module == null) { return -1; }
  let sum = 0;
  for (let i = 0; i < values.length; i++) { if (Reflect.findType(module, 'Counter') != null) { sum++; } }
  return sum;
}
export func memberLookup(values: int[]): int {
  let sum = 0;
  for (let i = 0; i < values.length; i++) { if (info.findField('value') != null) { sum++; } }
  return sum;
