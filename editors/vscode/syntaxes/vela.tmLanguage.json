{
  "name": "Vela",
  "scopeName": "source.vela",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    {
      "match": "\\b(class|interface|enum|type)(\\s+)([A-Za-z_][A-Za-z_0-9]*)",
      "captures": {
        "1": { "name": "storage.type.vela" },
        "3": { "name": "entity.name.type.vela" }
      }
    },
    { "name": "storage.type.function.vela", "match": "\\bfunc\\b" },
    { "name": "keyword.control.vela", "match": "\\b(?:if|else|while|for|switch|case|default|break|continue|return|match|try|catch|finally|throw|import|export|as|is)\\b" },
    { "name": "storage.modifier.vela", "match": "\\b(?:private|static|external|let|const)\\b" },
    { "name": "storage.type.vela", "match": "\\b(?:class|interface|extends|implements|enum|type|constructor)\\b" },
    { "name": "support.type.vela", "match": "\\b(?:dynamic|int|double|bool|string|void|String|Set|Map|Math|Random|Date|Error|Json)\\b" },
    { "name": "support.variable.vela", "match": "\\bperformance\\b" },
    { "name": "constant.language.vela", "match": "\\b(?:true|false|null)\\b" },
    { "name": "variable.language.vela", "match": "\\bthis\\b" },
    { "name": "constant.numeric.vela", "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" },
    { "name": "entity.name.function.vela", "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()" },
    { "name": "variable.other.property.vela", "match": "(?<=\\.)[A-Za-z_][A-Za-z_0-9]*\\b" },
    { "name": "variable.other.readwrite.vela", "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b" },
    { "name": "keyword.operator.vela", "match": "=>|==|!=|<=|>=|&&|\\|\\||[+*/!<>=?-]" },
    { "name": "punctuation.accessor.vela", "match": "\\." }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.vela", "begin": "///", "end": "$" },
        { "name": "comment.line.double-slash.vela", "begin": "//", "end": "$" },
        { "name": "comment.block.vela", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.single.vela", "begin": "'", "end": "'", "patterns": [{ "include": "#string-content" }] },
        { "name": "string.quoted.double.vela", "begin": "\"", "end": "\"", "patterns": [{ "include": "#string-content" }] }
      ]
    },
    "string-content": {
      "patterns": [
        { "name": "constant.character.escape.vela", "match": "\\\\(?:u\\{[0-9A-Fa-f]{1,6}\\}|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|[nrtbfv0\\\\\"'$])" },
        { "include": "#interpolation" },
        { "name": "invalid.illegal.escape.vela", "match": "\\\\." }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.vela",
      "contentName": "meta.embedded.line.vela",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.vela" } },
      "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.vela" } },
      "patterns": [{ "include": "#braced-expression" }, { "include": "$self" }]
    },
    "braced-expression": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#braced-expression" }, { "include": "$self" }]
    }
  }
}
