{
  "name": "vela-language",
  "displayName": "Vela",
  "description": "Vela syntax, completion, hover, import links, go to definition, diagnostics, formatting and running files.",
  "version": "0.1.18",
  "publisher": "vela",
  "license": "MIT",
  "engines": { "vscode": "^1.143.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "configurationDefaults": { "[vela]": { "editor.semanticHighlighting.enabled": true } },
    "semanticTokenScopes": [{
      "language": "vela",
      "scopes": {
        "class": ["entity.name.type.class.vela"],
        "interface": ["entity.name.type.interface.vela"],
        "enum": ["entity.name.type.enum.vela"],
        "type": ["entity.name.type.vela"],
        "typeParameter": ["entity.name.type.parameter.vela"]
      }
    }],
    "languages": [{
      "id": "vela",
      "aliases": ["Vela", "vela"],
      "extensions": [".vela"],
      "configuration": "./language-configuration.json",
      "icon": { "light": "./icons/vela-light.svg", "dark": "./icons/vela-dark.svg" }
    }],
    "grammars": [{ "language": "vela", "scopeName": "source.vela", "path": "./syntaxes/vela.tmLanguage.json" }],
    "commands": [
      { "command": "vela.showOutput", "title": "Vela: Show Language Server Output" },
      { "command": "vela.runFile", "title": "Vela: Run File", "icon": "$(play)",
        "enablement": "editorLangId == vela && resourceScheme == file && workspaceFolderCount != 0" }
    ],
    "menus": {
      "editor/title": [{ "command": "vela.runFile", "when": "resourceLangId == vela && resourceScheme == file", "group": "navigation@10" }],
      "editor/context": [{ "command": "vela.runFile", "when": "editorLangId == vela && resourceScheme == file", "group": "navigation@10" }],
      "commandPalette": [{ "command": "vela.runFile", "when": "editorLangId == vela" }]
    },
    "keybindings": [{
      "command": "editor.action.triggerSuggest",
      "key": "alt+/",
      "when": "editorTextFocus && editorLangId == vela && !editorReadonly"
    }],
    "configuration": {
      "title": "Vela",
      "properties": {
        "vela.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Vela executable for the language server and Run File. Relative paths use the first workspace folder; the default is out/debug/vela (.exe on Windows)."
        },
        "vela.diagnosticsDelay": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "maximum": 1000,
          "description": "Delay in milliseconds before sending changed document text to the server."
        }
      }
    }
  }
}
