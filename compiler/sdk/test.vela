/// A failed test assertion. This exception is active in every build configuration.
export class TestFailure {
  message: string;
  difference: MatchDifference? = null;
  mock: dynamic = null;
}

/// Raises a test assertion failure at the current script call site.
export func fail(message: string): void {
  throw TestFailure(message: message);
}

/// A structured difference produced by a matcher, independent of display budgets.
export class MatchDifference {
  path: string;
  actual: string;
  children: MatchDifference[] = [];
}

/// A matcher's result. Diagnostics remain structured until a reporter renders them.
export class MatchResult {
  success: bool;
  description: string;
  difference: MatchDifference? = null;
}

/// Implement this interface to define a synchronous matcher.
export interface Matcher {
  match(actual: dynamic): MatchResult;
}

/// Implement this interface for matchers that wait for asynchronous work.
export interface AsyncMatcher {
  matchAsync(actual: dynamic): Future<MatchResult>;
}

/// An inherited inactivity timeout. Absolute durations are in milliseconds.
export class Timeout {
  private durationValue: int;
  private factorValue: double = 1.0;
  private modeValue: int = 0;

  constructor(milliseconds: int) {
    if (milliseconds < 0) {
      throw Error(message: 'Timeout milliseconds must be nonnegative');
    }
    this.durationValue = milliseconds;
  }

  /// Multiplies the inherited timeout. An inherited disabled timeout stays disabled.
  static factor(value: double): Timeout {
    if (!Math.isFinite(value) || value <= 0.0) {
      throw Error(message: 'Timeout factor must be positive and finite');
    }
    const result = Timeout(0);
    result.modeValue = 1;
    result.factorValue = value;
    return result;
  }

  /// Disables inactivity timeouts for this scope.
  static none(): Timeout {
    const result = Timeout(0);
    result.modeValue = 2;
    return result;
  }

  get milliseconds(): int { return this.durationValue; }
  get multiplier(): double { return this.factorValue; }
  get mode(): int { return this.modeValue; }
}

external func publishRegistration(operation: int, description: string, callback: dynamic,
                       skip: dynamic, tags: dynamic, timeoutMode: int,
                       milliseconds: int, multiplier: double): void;

func registerTestEvent(operation: int, description: string, callback: dynamic,
               skip: dynamic, timeout: Timeout?, tags: dynamic): void {
  let mode = -1;
  let milliseconds = 0;
  let multiplier = 1.0;
  if (timeout != null) {
    mode = timeout.mode;
    milliseconds = timeout.milliseconds;
    multiplier = timeout.multiplier;
  }
  publishRegistration(operation, description, callback, skip, tags, mode, milliseconds, multiplier);
}

/// Registers a synchronous or asynchronous test. Ordinary return values are ignored.
export func test(description: string, body: dynamic, skip: dynamic,
                 timeout: Timeout?, tags: dynamic): void {
  registerTestEvent(0, description, body, skip, timeout, tags);
}

/// Registers nested tests synchronously. The body must return void.
export func group(description: string, body: dynamic, skip: dynamic,
                  timeout: Timeout?, tags: dynamic): void {
  registerTestEvent(1, description, body, skip, timeout, tags);
  try { body(); }
  finally { registerTestEvent(2, '', null, null, null, null); }
}

/// Runs before each selected test in this group, from outer groups to inner groups.
export func setUp(callback: dynamic): void { registerTestEvent(3, '', callback, null, null, null); }
/// Runs after each test, from inner groups to outer groups, in reverse registration order.
export func tearDown(callback: dynamic): void { registerTestEvent(4, '', callback, null, null, null); }
/// Runs once before the first selected test in this group.
export func setUpAll(callback: dynamic): void { registerTestEvent(5, '', callback, null, null, null); }
/// Runs once after the last selected test in this group.
export func tearDownAll(callback: dynamic): void { registerTestEvent(6, '', callback, null, null, null); }
/// Registers cleanup in the currently executing test or setUpAll scope.
export func addTearDown(callback: dynamic): void { registerTestEvent(7, '', callback, null, null, null); }

external func kindOfValue(value: dynamic): int;
external func displayValue(value: dynamic): string;
external func sameValue(left: dynamic, right: dynamic): bool;
external func trackExpectation(future: Future<void>): void;
external func registerCallback(callback: dynamic, minimum: int, maximum: int, arity: int): int;
external func enterCallback(identity: int): int;
external func exitCallback(previous: int): void;
external func checkCallback(identity: int): void;

func matchedResult(description: string): MatchResult {
  return MatchResult(success: true, description: description);
}

func mismatchedResult(actual: dynamic, description: string, path: string): MatchResult {
  return MatchResult(success: false, description: description,
                     difference: MatchDifference(path: path, actual: displayValue(actual)));
}

class MatchPath {
  parent: MatchPath?;
  segment: string;
}

func pathText(path: MatchPath?): string {
  const segments: string[] = [];
  let current = path;
  while (current != null) {
    segments.push(current.segment);
    current = current.parent;
  }
  segments.reverse();
  return segments.join('');
}

class DeepFrame {
  actual: dynamic;
  expected: dynamic;
  path: MatchPath?;
  forceUnordered: bool = false;
  initialized: bool = false;
  tracked: bool = false;
  kind: int = 0;
  length: int = 0;
  index: int = 0;
  column: int = 0;
  actualItems: dynamic = null;
  expectedItems: dynamic = null;
  edges: bool[][] = [];
}

func perfectMatching(edges: bool[][]): bool {
  const count = edges.length;
  const owner: int[] = [];
  const assigned: int[] = [];
  for (let index = 0; index < count; index++) { owner.push(-1); assigned.push(-1); }
  for (let source = 0; source < count; source++) {
    const parent: int[] = [];
    const seen: bool[] = [];
    for (let index = 0; index < count; index++) { parent.push(-1); seen.push(false); }
    const queue: int[] = [source];
    seen[source] = true;
    let head = 0;
    let free = -1;
    while (head < queue.length && free < 0) {
      const left = queue[head++];
      for (let right = 0; right < count; right++) {
        if (!edges[left][right] || parent[right] != -1) { continue; }
        parent[right] = left;
        if (owner[right] == -1) { free = right; break; }
        const next = owner[right];
        if (!seen[next]) { seen[next] = true; queue.push(next); }
      }
    }
    if (free < 0) { return false; }
    while (free >= 0) {
      const left = parent[free];
      const previous = assigned[left];
      assigned[left] = free;
      owner[free] = left;
      free = previous;
    }
  }
  return true;
}

class DeepComparison {
  stack: DeepFrame[] = [];
  active: Map<dynamic, Set<dynamic>> = Map<dynamic, Set<dynamic>>();

  finish(result: MatchResult): MatchResult {
    const frame = this.stack.pop();
    if (frame != null && frame.tracked) {
      const pairs = this.active.get(frame.actual);
      if (pairs != null) {
        pairs.delete(frame.expected);
        if (pairs.size == 0) { this.active.delete(frame.actual); }
      }
    }
    return result;
  }

  initialize(frame: DeepFrame): MatchResult? {
    frame.initialized = true;
    const expected = frame.expected;
    if (expected is Matcher) {
      const result = expected.match(frame.actual);
      if (!result.success && frame.path != null) {
        const children: MatchDifference[] = [];
        const difference = result.difference;
        if (difference != null) { children.push(difference); }
        return MatchResult(success: false, description: result.description,
                           difference: MatchDifference(path: pathText(frame.path), actual: displayValue(frame.actual),
                                                       children: children));
      }
      return result;
    }
    if (sameValue(frame.actual, expected)) { return matchedResult(displayValue(expected)); }
    const actualKind = kindOfValue(frame.actual);
    const expectedKind = kindOfValue(expected);
    if (frame.forceUnordered && (actualKind == 1 || actualKind == 3) &&
        (expectedKind == 1 || expectedKind == 3)) {
      frame.kind = 3;
    } else {
      if (actualKind != expectedKind || actualKind == 0 || actualKind == 4) {
        return mismatchedResult(frame.actual, displayValue(expected), pathText(frame.path));
      }
      frame.kind = actualKind;
    }
    let pairs = this.active.get(frame.actual);
    if (pairs != null && pairs.has(expected)) { return matchedResult(displayValue(expected)); }
    if (pairs == null) {
      pairs = Set<dynamic>();
      this.active.set(frame.actual, pairs);
    }
    pairs.add(expected);
    frame.tracked = true;
    if (frame.kind == 1) {
      frame.actualItems = frame.actual;
      frame.expectedItems = expected;
    } else if (frame.kind == 2) {
      frame.actualItems = frame.actual.keys();
      frame.expectedItems = expected.keys();
    } else {
      frame.actualItems = actualKind == 1 ? frame.actual : frame.actual.values();
      frame.expectedItems = expectedKind == 1 ? expected : expected.values();
    }
    frame.length = valueLength(frame.expectedItems);
    if (frame.actualItems.length != frame.length) {
      return mismatchedResult(frame.actual, 'length ${frame.length}', '${pathText(frame.path)}.length');
    }
    if (frame.kind == 3) {
      for (let row = 0; row < frame.length; row++) {
        const edges: bool[] = [];
        for (let column = 0; column < frame.length; column++) { edges.push(false); }
        frame.edges.push(edges);
      }
    }
    return null;
  }

  run(actual: dynamic, expected: dynamic, unordered: bool): MatchResult {
    this.stack.push(DeepFrame(actual: actual, expected: expected, path: null, forceUnordered: unordered));
    let completed: MatchResult? = null;
    while (this.stack.length != 0) {
      const frame = this.stack[this.stack.length - 1];
      const child = completed;
      completed = null;
      if (child != null) {
        if (frame.kind == 3) {
          frame.edges[frame.index][frame.column] = child.success;
          frame.column++;
          if (frame.column == frame.length) { frame.column = 0; frame.index++; }
        } else {
          if (!child.success) { completed = this.finish(child); continue; }
          frame.index++;
        }
      }
      if (!frame.initialized) {
        const result = this.initialize(frame);
        if (result != null) { completed = this.finish(result); continue; }
      }
      if (frame.index == frame.length) {
        if (frame.kind == 3 && !perfectMatching(frame.edges)) {
          completed = this.finish(mismatchedResult(frame.actual, 'a one-to-one unordered match', pathText(frame.path)));
        } else {
          completed = this.finish(matchedResult(displayValue(frame.expected)));
        }
        continue;
      }
      if (frame.kind == 2) {
        const key: dynamic = frame.expectedItems[frame.index];
        const path = MatchPath(parent: frame.path, segment: '[${displayValue(key)}]');
        if (!containsKey(frame.actual, key)) {
          completed = this.finish(mismatchedResult(frame.actual, 'a map containing key ${displayValue(key)}', pathText(path)));
          continue;
        }
        this.stack.push(DeepFrame(actual: frame.actual.get(key), expected: frame.expected.get(key), path: path));
      } else {
        const expectedIndex = frame.kind == 3 ? frame.column : frame.index;
        this.stack.push(DeepFrame(actual: frame.actualItems[frame.index],
                                  expected: frame.expectedItems[expectedIndex],
                                  path: MatchPath(parent: frame.path, segment: '[${frame.index}]')));
      }
    }
    if (completed == null) { throw TestFailure(message: 'deep matcher did not produce a result'); }
    return completed;
  }
}

class EqualsMatcher implements Matcher {
  expected: dynamic;
  unordered: bool = false;
  match(actual: dynamic): MatchResult {
    return DeepComparison().run(actual, this.expected, this.unordered);
  }
}

/// Compares values deeply without changing language equality or numeric types.
export func equals(value: dynamic): Matcher { return EqualsMatcher(expected: value); }
class OrderedMatcher implements Matcher {
  expected: dynamic;
  match(actual: dynamic): MatchResult {
    const actualKind = kindOfValue(actual);
    if (actualKind != 1 && actualKind != 3) { return mismatchedResult(actual, 'an array or Set in order', ''); }
    const expected = this.expected;
    const actualItems: dynamic = actualKind == 1 ? actual : actual.values();
    const expectedItems: dynamic = kindOfValue(expected) == 1 ? expected : expected.values();
    return DeepComparison().run(actualItems, expectedItems, false);
  }
}

/// Compares arrays or Set iteration order, including nested values.
export func orderedEquals(values: dynamic): Matcher {
  const kind = kindOfValue(values);
  if (kind != 1 && kind != 3) { throw Error(message: 'orderedEquals requires an array or Set'); }
  return OrderedMatcher(expected: values);
}
/// Requires a complete one-to-one match, including overlapping custom matchers.
export func unorderedEquals(values: dynamic): Matcher {
  const kind = kindOfValue(values);
  if (kind != 1 && kind != 3) { throw Error(message: 'unorderedEquals requires an array or Set'); }
  return EqualsMatcher(expected: values, unordered: true);
}

func wrapMatcher(value: dynamic): Matcher {
  if (value is Matcher) { return value; }
  return equals(value);
}

func valueLength(value: dynamic): int {
  if (value is string) { return value.length; }
  const kind = kindOfValue(value);
  // 任意元素类型的容器只在此动态边界检查长度返回值。
  if (kind == 1) { return value.length as int; }
  if (kind == 2 || kind == 3) { return value.size as int; }
  return -1;
}

func containsKey(value: dynamic, key: dynamic): bool {
  // 调用方已确认 Map 种类，键和值的泛型参数仍由动态调用检查。
  return value.has(key) as bool;
}

class SimpleMatcher implements Matcher {
  mode: int;
  expected: dynamic = null;
  delta: double = 0.0;
  description: string;

  accepts(actual: dynamic): bool {
    if (this.mode == 0) { return sameValue(actual, this.expected); }
    if (this.mode == 1) { return actual == null; }
    if (this.mode == 2) { return actual != null; }
    if (this.mode == 3) { return actual is bool && actual; }
    if (this.mode == 4) { return actual is bool && !actual; }
    if (this.mode == 5 || this.mode == 6) {
      const expected = this.expected;
      if (!((actual is int && expected is int) || (actual is double && expected is double))) { return false; }
      return this.mode == 5 ? actual > expected : actual < expected;
    }
    if (this.mode == 7) {
      const expected = this.expected;
      if (!(actual is double) || !(expected is double)) { return false; }
      return Math.abs(actual - expected) <= this.delta;
    }
    if (this.mode == 8) {
      const expected = this.expected;
      if (actual is string && expected is string) { return actual.includes(expected); }
      const kind = kindOfValue(actual);
      if (kind == 2) { return containsKey(actual, expected); }
      if (kind != 1 && kind != 3) { return false; }
      const values: dynamic = kind == 1 ? actual : actual.values();
      const matcher = wrapMatcher(expected);
      const length = valueLength(values);
      for (let index = 0; index < length; index++) {
        if (matcher.match(values[index]).success) { return true; }
      }
      return false;
    }
    const length = valueLength(actual);
    if (this.mode == 9) { return length >= 0 && length == this.expected; }
    if (this.mode == 10) { return length == 0; }
    return length > 0;
  }

  match(actual: dynamic): MatchResult {
    const description = this.description;
    return this.accepts(actual) ? matchedResult(description) : mismatchedResult(actual, description, '');
  }
}

export func same(value: dynamic): Matcher {
  return SimpleMatcher(mode: 0, expected: value, description: 'same as ${displayValue(value)}');
}
export const isNull: Matcher = SimpleMatcher(mode: 1, description: 'null');
export const isNotNull: Matcher = SimpleMatcher(mode: 2, description: 'not null');
export const isTrue: Matcher = SimpleMatcher(mode: 3, description: 'true');
export const isFalse: Matcher = SimpleMatcher(mode: 4, description: 'false');
export func greaterThan(value: dynamic): Matcher {
  return SimpleMatcher(mode: 5, expected: value, description: 'greater than ${displayValue(value)}');
}
export func lessThan(value: dynamic): Matcher {
  return SimpleMatcher(mode: 6, expected: value, description: 'less than ${displayValue(value)}');
}
export func closeTo(value: double, delta: double): Matcher {
  if (!Math.isFinite(delta) || delta < 0.0) { throw Error(message: 'delta must be nonnegative and finite'); }
  return SimpleMatcher(mode: 7, expected: value, delta: delta, description: 'within ${delta} of ${value}');
}
export func contains(value: dynamic): Matcher {
  return SimpleMatcher(mode: 8, expected: value, description: 'contains ${displayValue(value)}');
}
export func hasLength(length: int): Matcher {
  return SimpleMatcher(mode: 9, expected: length, description: 'length ${length}');
}
export const isEmpty: Matcher = SimpleMatcher(mode: 10, description: 'empty');
export const isNotEmpty: Matcher = SimpleMatcher(mode: 11, description: 'not empty');

class NotMatcher implements Matcher {
  matcher: Matcher;
  match(actual: dynamic): MatchResult {
    const result = this.matcher.match(actual);
    return result.success ? mismatchedResult(actual, 'not ${result.description}', '') : matchedResult('not ${result.description}');
  }
}

class CompositeMatcher implements Matcher {
  mode: int;
  matchers: Matcher[];
  match(actual: dynamic): MatchResult {
    const matchers = this.matchers;
    const differences: MatchDifference[] = [];
    for (const matcher in matchers) {
      const result = matcher.match(actual);
      if (this.mode == 1 && !result.success) { return result; }
      if (this.mode == 2 && result.success) { return result; }
      const difference = result.difference;
      if (difference != null) { differences.push(difference); }
    }
    if (this.mode == 1) { return matchedResult('all matchers'); }
    return MatchResult(success: false, description: 'any matcher',
                       difference: MatchDifference(path: '', actual: displayValue(actual), children: differences));
  }
}

func matcherList(values: dynamic): Matcher[] {
  const matchers: Matcher[] = [];
  const count = valueLength(values);
  for (let index = 0; index < count; index++) { matchers.push(wrapMatcher(values[index])); }
  return matchers;
}

export func isNot(matcher: dynamic): Matcher { return NotMatcher(matcher: wrapMatcher(matcher)); }
export func allOf(matchers: dynamic): Matcher {
  if (kindOfValue(matchers) != 1) { throw Error(message: 'allOf requires an array'); }
  return CompositeMatcher(mode: 1, matchers: matcherList(matchers));
}
export func anyOf(matchers: dynamic): Matcher {
  if (kindOfValue(matchers) != 1) { throw Error(message: 'anyOf requires an array'); }
  return CompositeMatcher(mode: 2, matchers: matcherList(matchers));
}

class PredicateMatcher implements Matcher {
  callback: (dynamic) => bool;
  description: string;
  match(actual: dynamic): MatchResult {
    const result = this.callback(actual);
    return result ? matchedResult(this.description) : mismatchedResult(actual, this.description, '');
  }
}

export func predicate(callback: (dynamic) => bool, description: string): Matcher {
  return PredicateMatcher(callback: callback, description: description);
}

class ThrowsMatcher implements Matcher, AsyncMatcher {
  expected: dynamic;
  match(actual: dynamic): MatchResult {
    try { actual(); }
    catch (error: dynamic) { return wrapMatcher(this.expected).match(error); }
    return mismatchedResult(actual, 'a function throwing ${displayValue(this.expected)}', '');
  }
  async matchAsync(actual: dynamic): Future<MatchResult> {
    try { await actual; }
    catch (error: dynamic) { return wrapMatcher(this.expected).match(error); }
    return mismatchedResult(actual, 'a Future failing with ${displayValue(this.expected)}', '');
  }
}

export func throwsA(matcher: dynamic): Matcher { return ThrowsMatcher(expected: matcher); }

func assertMatch(actual: dynamic, result: MatchResult, reason: string?): void {
  if (!result.success) {
    let message = 'Expected: ${result.description}; actual: ${displayValue(actual)}';
    const difference = result.difference;
    if (difference != null && difference.path != '') { message = '${message}; at ${difference.path}'; }
    if (reason != null) { message = '${message}; ${reason}'; }
    throw TestFailure(message: message, difference: difference);
  }
}

func asyncExpectation(actual: dynamic, matcher: dynamic): AsyncMatcher? {
  if (matcher is AsyncMatcher && (kindOfValue(actual) == 4 || !(matcher is Matcher))) {
    return matcher;
  }
  return null;
}

async func evaluateLater(actual: dynamic, matcher: dynamic, reason: string?): Future<void> {
  const asynchronous = asyncExpectation(actual, matcher);
  if (asynchronous != null) {
    const result = await asynchronous.matchAsync(actual);
    assertMatch(actual, result, reason);
  } else {
    assertMatch(actual, wrapMatcher(matcher).match(actual), reason);
  }
}

/// Matches synchronously or registers an asynchronous expectation with the current test.
export func expect(actual: dynamic, matcher: dynamic, reason: string?): void {
  if (asyncExpectation(actual, matcher) != null) {
    trackExpectation(evaluateLater(actual, matcher, reason));
  } else {
    assertMatch(actual, wrapMatcher(matcher).match(actual), reason);
  }
}

/// Returns the expectation Future. The current test also waits when the caller omits await.
export func expectLater(actual: dynamic, matcher: dynamic, reason: string?): Future<void> {
  const future = evaluateLater(actual, matcher, reason);
  trackExpectation(future);
  return future;
}

class CompletionMatcher implements AsyncMatcher {
  expected: dynamic = null;
  checkValue: bool = false;
  async matchAsync(actual: dynamic): Future<MatchResult> {
    if (!this.checkValue) { await actual; return matchedResult('a successfully completing Future'); }
    const result: dynamic = await actual;
    return wrapMatcher(this.expected).match(result);
  }
}

export const completes: AsyncMatcher = CompletionMatcher();
export func completion(matcher: dynamic): AsyncMatcher {
  return CompletionMatcher(expected: matcher, checkValue: true);
}

/// Keeps the test open until count calls occur, and rejects calls beyond max.
export func expectAsync0(callback: dynamic, count: int?, max: int?): () => void {
  const minimum = count ?? 1;
  const maximum = max ?? minimum;
  const identity: int = registerCallback(callback, minimum, maximum, 0);
  return (): void => {
    const previous: int = enterCallback(identity);
    try {
      checkCallback(identity);
      callback();
    } finally { exitCallback(previous); }
  };
}

/// The argument type must be explicitly specialized, for example expectAsync1<int>(callback).
export func expectAsync1<T>(callback: dynamic, count: int?, max: int?): (T) => void {
  const minimum = count ?? 1;
  const maximum = max ?? minimum;
  const identity: int = registerCallback(callback, minimum, maximum, 1);
  return (value: T): void => {
    const previous: int = enterCallback(identity);
    try {
      checkCallback(identity);
      callback(value);
    } finally { exitCallback(previous); }
  };
}
