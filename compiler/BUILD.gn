source_set("build_info") {
  sources = [
    "build_info.cc",
    "build_info.h",
  ]
}

source_set("frontend") {
  sources = [
    "frontend/ast.h",
    "frontend/checker.cc",
    "frontend/checker.h",
    "frontend/diagnostic.h",
    "frontend/lexer.cc",
    "frontend/lexer.h",
    "frontend/parser.cc",
    "frontend/parser.h",
    "frontend/token.h",
    "frontend/type_checker.cc",
    "frontend/type_checker.h",
  ]
  public_deps = [ "//third_party:abseil" ]
}

source_set("ir") {
  sources = [
    "ir/ir.h",
    "ir/lowerer.cc",
    "ir/lowerer.h",
    "ir/lowerer_array.cc",
    "ir/lowerer_double.cc",
  ]
  deps = [ ":frontend" ]
  public_deps = [ "//third_party:abseil" ]
}

source_set("compiler") {
  sources = [
    "compiler.cc",
    "compiler.h",
  ]
  public_deps = [
    ":frontend",
    ":ir",
    "//runtime",
    "//vm",
  ]
  deps = [ "//third_party:abseil" ]
}

executable("vela") {
  sources = [ "vela_main.cc" ]
  deps = [
    ":build_info",
    ":compiler",
  ]
}

