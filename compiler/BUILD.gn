generated_file("cache_build_identity") {
  outputs = [ "$target_gen_dir/cache_build_identity.h" ]
  contents = [
    "#pragma once",
    "#include <string_view>",
    "namespace vela::compiler {",
    "inline constexpr std::string_view kCompilerBuildIdentity = \"$vela_build_identity\";",
    "}",
    "",
  ]
}

action("sdk_sources") {
  script = "//tools/embed_sdk.py"
  inputs = [
    "sdk/test.vela",
    "sdk/mock.vela",
  ]
  outputs = [ "$target_gen_dir/sdk_sources.h" ]
  args = [
    "--source",
    rebase_path(inputs[0], root_build_dir),
    "--source",
    rebase_path(inputs[1], root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

