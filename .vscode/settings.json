{
  "vela.serverPath": "out/release/vela.exe",
  "[vela]": {
    "editor.defaultFormatter": "vela.vela-language",
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    },
    "editor.suggestOnTriggerCharacters": true,
    "editor.links": true
  },
  "files.exclude": {
    "**/.cache": true,
    "**/.cipd": true,
    "**/out": true
  },
  "search.exclude": {
    "**/.cache": true,
    "**/.cipd": true,
    "**/out": true
  }
}
