class Cursor {
  calls: int;

  next(): int {
    this.calls += 1;
    return 0;
  }
}

func main(): void {
  let value = 18;
  value += 6;
  value -= 4;
  value *= 3;
  value /= 5;
  value %= 5;
  value &= 3;
  value |= 8;
  value ^= 3;
  value <<= 2;
  value >>= 1;
  value >>>= 1;
  print(value); // 9

  print(value++); // 9: return the old value, then update.
  print(++value); // 11: update, then return the new value.
  print(value--); // 11
  print(--value); // 9

  const values = [10];
  const cursor = Cursor(calls: 0);
  values[cursor.next()] += 5;
  print(values[0]); // 15
  print(cursor.calls); // 1: the index expression is evaluated once.
}
