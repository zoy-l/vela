enum Shade { light, dark }

class Item {
  int value;
  int read() { return this.value; }
}

class Inventory {
  Item[] items;
  string[] labels;
  bool[] enabled;
  Shade[] shades;
  int total() { return this.items[0].read() + this.items[1].read(); }
}

int[][] matrix() { return [[], [20, 22]]; }

int main() {
  Inventory inventory = Inventory(
    items: [Item(value: 20), Item(value: 22)],
    labels: ["first", "second"],
    enabled: [true, false],
    shades: [.light, .dark],
  );
  bool[] alias = inventory.enabled;
  alias[1] = true;
  int[][] rows = matrix();
  rows[0] = [inventory.total()];
  print(inventory.labels[1]);
  print(inventory.enabled[1]);
  print(rows[0][0]);
  return rows[1][0] + rows[1][1];
}
