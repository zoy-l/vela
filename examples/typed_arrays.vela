enum Shade { light, dark }

class Item {
  value: int;
  read(): int { return this.value; }
}

class Inventory {
  items: Item[];
  labels: string[];
  enabled: bool[];
  shades: Shade[];
  total(): int { return this.items[0].read() + this.items[1].read(); }
}

func matrix(): int[][] { return [[], [20, 22]]; }

func main(): int {
  let inventory: Inventory = Inventory(
    items: [Item(value: 20), Item(value: 22)],
    labels: ["first", "second"],
    enabled: [true, false],
    shades: [.light, .dark],
  );
  let alias: bool[] = inventory.enabled;
  alias[1] = true;
  let rows: int[][] = matrix();
  rows[0] = [inventory.total()];
  print(inventory.labels[1]);
  print(inventory.enabled[1]);
  print(rows[0][0]);
  return rows[1][0] + rows[1][1];
}
