class Label {
  param text: string?;

  display(): string {
    const text = this.text;
    if (text == null) return 'empty';
    return 'label: ${text}';
  }
}

func read(value: int?): int {
  if (value != null) return value;
  return 0;
}

func main(): int {
  const values: int?[] = [40, null, 2];
  print(Label(text: 'Vela').display());
  print(Label(text: null).display());
  return read(values[0]) + read(values[1]) + read(values[2]);
}
