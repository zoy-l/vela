func main(): int {
  Random.seed(42);
  const started = Time.monotonicMicros();
  const values: int[] = [3, 1, 2];
  values.sort((left: int, right: int): int => left - right);
  const total = values.reduce(0, (sum: int, value: int): int => sum + value);
  print('total: ${total}');
  print('sqrt(9): ${Math.sqrt(9.0)}');
  print('seeded random: ${Random.nextInt(100)}');
  print('elapsed us: ${(Time.monotonicMicros() - started)}');
  return 0;
}
