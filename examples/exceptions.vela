class ValidationError {
  public param message: string;
}
func validate(value: int): int {
  if (value < 0) {
    throw ValidationError(message: "value must be nonnegative");
  }
  return value;
}
func main(): int {
  try {
    validate(-1);
  } catch (error: ValidationError) {
    print(error.message);
  } finally {
    print("validation finished");
  }
  try {
    let zero = 0;
    return 42 / zero;
  } catch (error: Error) {
    print(error.message);
    return 42;
  }
}
