import 'modules/string\u005Ftools';

func main(): void {
  const name = 'Vela';
  print('Hello, ${name}! 版本 ${1}');
  print('转义："引号"、\\、\n换行、\${原样保留}');
  const text = 'A中\u{1F600}e\u0301';
  print('码点 ${text.length}，字节 ${text.byteLength}');
  print('索引 ${text[2]}，切片 ${text.slice(start: 1, end: 3)}');
  print('查找位置 ${text.indexOf('e')}');
  print(
    '包含 ${text.contains('中😀')}，前缀 ${text.startsWith('A')}，后缀 ${text.endsWith('\u0301')}'
  );
  print(describe('${name} / ${42} / ${true}'));
  print(['Vela', 'strings'].join(' / '));
  print([1, 2, 3].join(', '));
  print('count=' + 42 + ', enabled=' + true);
}
