func main(): void {
  const values: int[] = [3, 1, 2];
  values.sort((left, right) => left - right);
  values.forEach(value => { print(value); });

  const sum = values.reduce((total, value) => total + value, 0);
  print('sum: ${sum}');
  print(values.some(value => value == 2));
  print(values.every(value => value > 0));
  print(values.findIndex(value => value == 3));
  const mapped = values.map(value => value * 10);
  print(mapped[0]);
  print('original: ${values.join(", ")}');

  const left = Set<string>();
  const right = Set<string>();
  left.add('a');
  left.add('b');
  right.add('b');
  right.add('c');
  print('union: ${left.union(right).size}');
  print('intersection: ${left.intersection(right).size}');
  print('difference: ${left.difference(right).size}');
}
