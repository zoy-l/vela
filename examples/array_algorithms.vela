func main(): void {
  const values: int[] = [3, 1, 2];
  values.sort((left: int, right: int): int => left - right);
  values.forEach((value: int): void => { print(value); });

  const sum = values.reduce(0, (total: int, value: int): int => total + value);
  print('sum: ${sum.toString()}');
  print(values.any((value: int): bool => value == 2));
  print(values.every((value: int): bool => value > 0));
  print(values.findIndex((value: int): bool => value == 3));
  values.transform((value: int): int => value * 10);
  print(values[0]);

  const left = Set<string>();
  const right = Set<string>();
  left.add('a');
  left.add('b');
  right.add('b');
  right.add('c');
  print('union: ${left.union(right).length.toString()}');
  print('intersection: ${left.intersection(right).length.toString()}');
  print('difference: ${left.difference(right).length.toString()}');
}
