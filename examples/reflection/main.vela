class Button extends Reflect {
  label: string = '';
}

[Reflect]
class Counter {
  value: int = 10;

  get doubled(): int {
    return this.value * 2;
  }

  [Button(label: 'Add')]
  add(amount: int): int {
    this.value += amount;
    return this.value;
  }
}

enum State {
  Idle,
  [Reflect]
  Active,
}

const info = Reflect.typeInfo<Counter>();
const counter = createCounter();
const field = info.findField('value');
const method = info.findMethod('add');

func createCounter(): Counter {
  const factory = info.getConstructor();
  if (factory == null) { throw Error(message: 'Counter constructor is not registered'); }
  const created = factory.invoke(CallArguments());
  if (created is Counter) { return created; }
  throw Error(message: 'Expected a Counter instance');
}

func main(): void {
  const valueField = field;
  const add = method;
  if (valueField == null || add == null) { return; }
  print(info.name); // Counter

  valueField.setValue(counter, 20);
  print(valueField.getValue(counter)); // 20

  const property = info.findProperty('doubled');
  if (property == null) { return; }
  print(property.getValue(counter)); // 40

  const arguments = CallArguments(items: [
    CallArgument(value: 22, name: 'amount'),
  ]);
  print(add.invoke(counter, arguments)); // 42
  print(Reflect.typeOf(counter).id == info.id); // true

  const module = info.module;
  if (module == null) { return; }
  const discovered = Reflect.findType(module, 'Counter');
  if (discovered == null) { return; }
  print(discovered.id == info.id); // true
  print(Reflect.getTypes(module).length); // 2

  const state = Reflect.typeInfo<State>();
  const member = state.findEnumMember('Active');
  if (member == null) { return; }
  print(member.ordinal); // 1
  print(Reflect.typeOf(member.value).id == state.id); // true

  const buttons = Reflect.findMethods<Button>();
  print(buttons[0].attribute.label); // Add
}

// 在开发控制台用 .call next 调用；热重载后仍通过原句柄解析当前方法。
export func next(): int {
  const add = method;
  if (add == null) { return -1; }
  const arguments = CallArguments(items: [
    CallArgument(value: 1, name: 'amount'),
  ]);
  const result = add.invoke(counter, arguments);
  if (result is int) { return result; }
  throw Error(message: 'Counter.add returned a non-integer value');
}
