func divide(value: int, denominator: int): Expected<int, string> {
  if (denominator == 0) {
    return err("division by zero");
  }
  return ok(value / denominator);
}

func main(): void {
  const result: Expected<int, string> = divide(84, 2);
  if (result.hasValue()) {
    print(result.value());
  } else {
    print(result.error());
  }
}
