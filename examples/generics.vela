type Operation<T> = (T) => T;

func identity<T>(value: T): T {
  return value;
}

class Box<T> {
  value: T;

  get(): T {
    return this.value;
  }
}

func main(): void {
  const operation: Operation<int> = identity<int>;
  const value = Box<int>(value: operation(42));
  print(value.get());
  print(identity<double>(1.5));
}
