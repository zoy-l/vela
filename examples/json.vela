class User {
  name: string;
  age: int;

  toJson(): Map<string, dynamic> {
    const fields = Map<string, dynamic>();
    fields.set('name', this.name);
    fields.set('age', this.age);
    return fields;
  }
}

class Payload {
  name: string;
  items: dynamic[];
}

func main(): int {
  const root = JSON.parse<Payload>('{"name":"Vela","items":[7,true,null]}');
  const name = root.name;
  const items = root.items;
  const first = items[0];
  if (!(first is int)) {
    return 1;
  }
  print(name);
  print(JSON.stringify(items));

  const users = [User(name: name, age: first)];
  const output = JSON.stringify(users);
  print(output);

  const parsed = JSON.safeParse<User[]>(output);
  if (!parsed.success) {
    print('${parsed.error.path}: ${parsed.error.message}');
    return 1;
  }
  const integers = JSON.parse<int[]>('[20,22]');
  print(integers.reduce((total, value) => total + value, 0));
  return parsed.value[0].age == 7 && output == '[{"name":"Vela","age":7}]' && integers[0] + integers[1] == 42 ? 0 : 1;
}
