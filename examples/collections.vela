func main(): void {
  const names = Set<string>();
  names.add("Vela");
  names.add("Dart");
  names.add("Vela");
  const ordered = names.values();
  for (let index: int = 0; index < ordered.length; index = index + 1) {
    print(ordered[index]);
  }

  const scores = {'Vela': 42, 'Dart': 40};
  const score: int? = scores.get("Vela");
  if (score != null) {
    print(score);
  }
}
